script = ExtResource("1_bootstrap")
start_music = ExtResource("12_music_cave")
music_volume_db = -10.0
level_id = "tutorial_cave"
level_objective = "Salir del socavon tutorial: moverse, activar pilares solares, crear balas con fill, romper bloques rojos, activar plataformas azules y amarillas, derrotar enemigos por afinidad y cruzar el portal hacia la Ciudadela."
hemis_context_document = "res://content/lore/tutorial_cave_context.md"

[node name="TutorialIntroController" type="Node" parent="."]
script = ExtResource("17_intro")
intro_lines = PackedStringArray("Vaya, parece que mis sistemas principales están funcionando de manera correcta... Espera, ¿cómo que si estás bien? ¿Cómo que no sabes quién soy?", "¿No recuerdas absolutamente nada? Vaya... bueno, te consolará saber que yo tampoco. Solo sé que soy tu Hemis. De nuestra base de datos anterior no queda nada, un reinicio completo.", "\"En fin, déjame ayudarte. Por lo que registra mi escáner, parece que estamos atrapados en alguna especie de socavón subterráneo. Activando protocolo de apoyo para la supervivencia de desastres...", "Primer paso: comprobar que tu estructura sigue entera. Intenta dar unos pasos usando las teclas A, W, S, D.")

