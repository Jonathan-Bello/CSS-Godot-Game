[node name="HemisTutorialTriggers" type="Node2D" parent="."]

[node name="MovementReminder" parent="HemisTutorialTriggers" instance=ExtResource("9_hemis")]
position = Vector2(1740, 952)
scale = Vector2(1.8, 2)
dialog_lines = PackedStringArray("También puedes usar la barra Espaciadora para dar un impulso. Aunque imagino que recordar cómo usar tus propias piernas es algo que ya venía de nacimiento... o de fábrica", "lo que sea que aplique para un humano tan extraño como tú. La verdad, no estoy segura.", "Y si, soy yo quien flota sobre tu cabeza")

[node name="SolarPillarIntro" parent="HemisTutorialTriggers" instance=ExtResource("9_hemis")]
position = Vector2(4449, 505.00003)
scale = Vector2(0.6, 3)
dialog_lines = PackedStringArray("Mira eso de ahí adelante, es un Pilar Solar. Funciona como Pilar solar de guardado y estación de abastecimiento. Pero antes de que te acerques a tocar tecnología desconocida, asegúrate de saber defenderte. ", "Apunta con el ratón y haz clic para disparar. Intenta no darme a mí, por favor.")

[node name="SolarPillarIntro2" parent="HemisTutorialTriggers" instance=ExtResource("9_hemis")]
position = Vector2(4916, 325)
scale = Vector2(1, 6)
dialog_lines = PackedStringArray("Anda, acércate al pilar y presiona la tecla E para abrir el panel de gestión de munición. Veamos qué nos dejó la ingeniería de este lugar.", "")

[node name="RedBlocksIntro" parent="HemisTutorialTriggers" instance=ExtResource("9_hemis")]
position = Vector2(5922, 615)
scale = Vector2(0.5, 1.2)
dialog_lines = PackedStringArray("Estos bloques reaccionan a propiedades CSS.", "Para este tramo basta con que tu bala contenga fill: red;. Si coincide ese color, el bloque recibe el impacto correcto y se rompe.", "Regresa al pilar si aun no has equipado esa propiedad y destruyelos para poder seguir.", "Y no te caigas, que de seguro duele.")

[node name="PlatformIntro" parent="HemisTutorialTriggers" instance=ExtResource("9_hemis")]
position = Vector2(7169, 1187)
scale = Vector2(3.2, 2.4)
dialog_lines = PackedStringArray("Las plataformas CSS funcionan parecido, pero en vez de romperse cambian de estado.", "Usa el segundo Pilar Solar y cambia el fill de tu proyectil. Las plataformas azules responden a fill: blue;.", "Fijate en el color de cada plataforma: si aparece una amarilla, cambia la bala a fill: yellow;.")

[node name="ExitReminder" parent="HemisTutorialTriggers" instance=ExtResource("9_hemis")]
position = Vector2(8291, -458)
scale = Vector2(1.2, 2)
dialog_lines = PackedStringArray("¡ESPERA!", "Detecto, algo. Parece ser un robot de seguridad.", "Qué extraño que una unidad de patrulla siga operativa en este sector tan profundamente abandonado.", "Disparale con tu munición CSS. Si su afinidad es azul, usa fill: blue; para causar mas daño.")

[node name="ExitReminder3" parent="HemisTutorialTriggers" instance=ExtResource("9_hemis")]
position = Vector2(11000, -311)
scale = Vector2(0.6, 4)
dialog_lines = PackedStringArray("¡Otro más! Pero espera, acabo de escanear su interfaz. Al igual que con los bloques de color, este robot tiene debilidad por afinidad.", "Si abres el Lienzo y editas tu bala para que coincida con las propiedades CSS de su blindaje, activarás una brecha de datos. El daño por afinidad lo destruirá mucho más rápido.", "¡Cuidado, viene con prisa! Ese modelo solo se mueve por el suelo y va a embestir. ¡Presiona la barra Espaciadora para saltarlo!")

